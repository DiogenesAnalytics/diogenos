Vagrant.configure("2") do |config|
  config.vm.define "box"
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.synced_folder ".", "/diogenos",
    type: "rsync",
    rsync__exclude: [
      ".git/",
      ".nox/",
      ".venv/",
      "**/__pycache__/",
      ".pytest_cache/",
      ".mypy_cache/",
      ".ruff_cache/",
      "dist/",
      "build/"
    ]

  config.vm.provider "libvirt" do |lv|
    lv.memory = 4096
    lv.cpus = 2
  end

  config.vm.provision "shell", inline: <<-SHELL
    set -eu

    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y \
      python3 \
      python3-venv \
      python3-pip \
      pipx \
      gdm3 \
      gnome-shell \
      ubuntu-session

    sudo -u vagrant pipx install poetry

    sudo -u vagrant env \
      PATH="/home/vagrant/.local/bin:$PATH" \
      bash -lc 'cd /diogenos && poetry install --with dev'

    cat > /etc/gdm3/custom.conf <<'EOF'
[daemon]
AutomaticLoginEnable=true
AutomaticLogin=vagrant
EOF

    systemctl set-default graphical.target
  SHELL
end
