Vagrant.configure("2") do |config|
  config.vm.box = "diogenos-e2e"

  config.vm.synced_folder ".", "/diogenos",
    type: "rsync",
    rsync__exclude: [
      ".git/",
      ".nox/",
      ".venv/",
      "__pycache__/",
      ".pytest_cache/",
      ".mypy_cache/",
      ".ruff_cache/",
      "dist/",
      "build/"
    ]

  config.vm.provider "libvirt" do |lv|
    lv.memory = 2048
    lv.cpus = 2
  end
end
